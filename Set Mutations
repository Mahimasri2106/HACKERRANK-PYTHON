# Enter your code here. Read input from STDIN. Print output to STDOUT
# Read the number of elements in initial set A (not strictly needed for the logic)
_ = input()
# Initialize set A
storage_set = set(map(int, input().split()))

# Read the number of other sets/operations
num_ops = int(input())

for _ in range(num_ops):
    # Get the operation name (the length is ignored as Python's methods handle it)
    op_name, _ = input().split()
    # Get the elements of the other set
    other_set = set(map(int, input().split()))
    
    # Use getattr to dynamically call the set method on storage_set
    getattr(storage_set, op_name)(other_set)

# Print the final sum of elements
print(sum(storage_set))
