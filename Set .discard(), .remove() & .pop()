n = int(input())
s = set(map(int, input().split()))
N = int(input())

for _ in range(N):
    command = input().split()
    if command[0] == 'pop':
        s.pop()
    elif command[0] == 'remove':
        try:
            s.remove(int(command[1]))
        except KeyError:
            continue # Or handle as required if 'remove' on non-existent element should be ignored
    elif command[0] == 'discard':
        s.discard(int(command[1]))

print(sum(s))
