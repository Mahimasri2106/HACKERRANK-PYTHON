# Enter your code here. Read input from STDIN. Print output to STDOUT
import re

# N is the number of lines
n = int(input())

# Regex Explanation:
# (?<=[: ,])  -> Positive lookbehind: ensures the match is preceded by ':', ' ', or ','
# #           -> Matches the hash symbol
# (           -> Start of group
#  [0-9a-fA-F]{6} -> Matches exactly 6 hex digits
#  |              -> OR
#  [0-9a-fA-F]{3} -> Matches exactly 3 hex digits
# )           -> End of group
# (?![0-9a-fA-F]) -> Negative lookahead: ensures no more hex digits follow (prevents partial matches)

pattern = r'(?<=[: ,])#([0-9a-fA-F]{6}|[0-9a-fA-F]{3})(?![0-9a-fA-F])'

for _ in range(n):
    line = input()
    matches = re.findall(pattern, line)
    if matches:
        for match in matches:
            print(f"#{match}")
